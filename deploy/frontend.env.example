# Public production frontend is served at ops.doobielogic.io by the PC-hosted Caddy edge.
# Keep API calls same-origin so remote browsers never try to call their own localhost.
VITE_API_URL=
# Supabase Auth is exposed through the same public edge and proxied back to the
# local Supabase gateway on the host PC.
VITE_SUPABASE_URL=https://ops.doobielogic.io
VITE_SUPABASE_PUBLISHABLE_KEY=publishable-anon-key

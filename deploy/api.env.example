# Active production runtime: ops.doobielogic.io -> Cloudflare Tunnel -> Caddy :8080 -> FastAPI :8010.
# The application is PC-hosted, while durable database/auth remain in the existing DoobieLogic Supabase project.
APP_ENV=production
CORS_ORIGINS=https://ops.doobielogic.io
ALLOWED_HOSTS=ops.doobielogic.io,doobielogic.io,localhost,127.0.0.1

# Use the durable PostgreSQL connection for the existing DoobieLogic Supabase project.
# Keep the real database credential server-side and out of Git.
DATABASE_URL=postgresql+psycopg://...

# Authoritative production Supabase project. Do not substitute a fresh local Supabase
# instance merely because FastAPI itself runs on the Windows PC.
SUPABASE_URL=https://fovxtygwcxubjzjgovva.supabase.co
SUPABASE_JWKS_URL=https://fovxtygwcxubjzjgovva.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=existing-enabled-publishable-or-anon-key
# Optional: required only by routes that deliberately perform Supabase admin operations.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
INTEGRATION_ENCRYPTION_KEY=stable-random-server-secret
METRC_INTEGRATOR_KEY=server-only

# Spacemail transactional onboarding mail. Authenticate with the real mailbox;
# DoobieLogic sends welcome mail from the configured support alias.
SPACEMAIL_SMTP_HOST=mail.spacemail.com
SPACEMAIL_SMTP_PORT=465
SPACEMAIL_SMTP_USERNAME=nelson@doobielogic.io
SPACEMAIL_SMTP_PASSWORD=server-only-mailbox-password
SPACEMAIL_SMTP_TIMEOUT_SECONDS=12
SPACEMAIL_FROM_EMAIL=support@doobielogic.io
SPACEMAIL_FROM_NAME=DoobieLogic Support
SPACEMAIL_SUPPORT_EMAIL=support@doobielogic.io
SPACEMAIL_HELP_EMAIL=help@doobielogic.io
SPACEMAIL_INFO_EMAIL=info@doobielogic.io
SPACEMAIL_LOGIN_URL=https://ops.doobielogic.io/
SPACEMAIL_WELCOME_EMAIL_ENABLED=true

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PORT=8080
WORKDIR /app
RUN apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*
RUN addgroup --system buyer && adduser --system --ingroup buyer buyer
COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --upgrade pip "setuptools>=78.1.1" \
    && pip install -r /tmp/requirements.txt \
    && pip uninstall -y setuptools \
    && rm -rf /usr/local/lib/python3.12/site-packages/setuptools \
        /usr/local/lib/python3.12/site-packages/setuptools-*.dist-info \
        /usr/local/lib/python3.12/site-packages/pkg_resources
COPY backend backend
COPY modules modules
COPY services services
COPY migrations migrations
COPY alembic.ini ./
COPY compliance_engine.py ai_providers.py doobielogic_client.py ./
USER buyer
EXPOSE 8080
CMD ["sh", "-c", "uvicorn backend.app.main:app --host 0.0.0.0 --port ${PORT:-8080} --proxy-headers --forwarded-allow-ips='*'"]

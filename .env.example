# Use the Supabase Session pooler (port 5432) for the hosted application.
# Never commit the real connection string or any real credentials.
COMAN_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# DoobieLogic native AI runtime. The FastAPI image does not contain a model.
# Point this at an independently running OpenAI-compatible endpoint (Ollama for development, vLLM or equivalent for production).
AI_PROVIDER_MODE=local_first
AI_PROVIDER_ORDER=local,gemini,openai,doobie
AI_ALLOW_CLOUD_FALLBACK=true
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=replace-with-local-model
LOCAL_LLM_TIMEOUT_SECONDS=30
LOCAL_LLM_MAX_TOKENS=1400
LOCAL_LLM_TEMPERATURE=0.2

# Local embeddings are optional. If unavailable, knowledge retrieval degrades to tenant-scoped lexical search.
LOCAL_EMBEDDING_BASE_URL=http://127.0.0.1:11434
LOCAL_EMBEDDING_API_KEY=
LOCAL_EMBEDDING_MODEL=replace-with-local-embedding-model
LOCAL_EMBEDDING_TIMEOUT_SECONDS=20

# Optional cloud escalation providers. Leave unset to keep them unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com

# Optional telemetry pricing inputs. Keep at zero if cost estimation is not configured.
AI_GEMINI_INPUT_COST_PER_MILLION=0
AI_GEMINI_OUTPUT_COST_PER_MILLION=0
AI_OPENAI_INPUT_COST_PER_MILLION=0
AI_OPENAI_OUTPUT_COST_PER_MILLION=0

# DoobieLogic cannabis AI + licensing service. AI use is optional; licensing settings remain independent.
DOOBIE_BASE_URL=https://your-doobielogic-api.example.com
DOOBIE_API_KEY=use-the-same-service-key-configured-on-doobielogic
DOOBIE_AI_MODEL=doobie-cloud

# Optional license cache/retry settings.
DOOBIE_LICENSE_RECHECK_HOURS=24
DOOBIE_LICENSE_GRACE_HOURS=48
DOOBIE_LICENSE_TIMEOUT_SECONDS=8

# Use the Supabase Session pooler (port 5432) for the hosted Streamlit app.
# Never commit the real connection string.
COMAN_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Gemini Buyer Agent. Use a Google AI Studio API key.
# The app makes no paid fallback calls; if Gemini quota is exhausted, Buyer Agent falls back to Doobie only when Doobie is connected.
GEMINI_API_KEY=replace-with-google-ai-studio-key
GEMINI_MODEL=gemini-3.5-flash-lite

# DoobieLogic cannabis AI + licensing service.
DOOBIE_BASE_URL=https://your-doobielogic-api.example.com
DOOBIE_API_KEY=use-the-same-service-key-configured-on-doobielogic

# Optional license cache/retry settings.
DOOBIE_LICENSE_RECHECK_HOURS=24
DOOBIE_LICENSE_GRACE_HOURS=48
DOOBIE_LICENSE_TIMEOUT_SECONDS=8
